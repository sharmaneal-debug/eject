# Eject — environment variables

# --- Optional LLM rebuild (scripts/rebuild.ts). Static move is the default. ---
# Preferred: OpenAI-compatible open-weights (DeepSeek Flash default).
# LLM_PROVIDER=openai-compat
# LLM_BASE_URL=https://api.deepseek.com
#   Together:  https://api.together.xyz/v1
#   Fireworks: https://api.fireworks.ai/inference/v1
#   OpenRouter:https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-flash
#   Together Flash slug: deepseek-ai/DeepSeek-V4-Flash-0731
#   Escalation:          qwen/qwen3-coder-480b-a35b (OpenRouter)

# Optional Anthropic path (also works with DeepSeek Anthropic-compatible URL):
#   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#   ANTHROPIC_API_KEY=<deepseek or anthropic key>
#   ANTHROPIC_MODEL=deepseek-flash
ANTHROPIC_API_KEY=

# Optional: Vercel AI Gateway key (vck_…). If set with the Anthropic path,
# scripts can route Claude calls through Vercel's gateway.
VERCEL_AI_GATEWAY_KEY=

# Soft spend abort for rebuild.ts (USD). Default 5. Harness runs should set 2.
# EJECT_REBUILD_SPEND_CAP_USD=2

# Resend (transactional email — kickoff emails after Stripe checkout)
# Reuse your existing Laniakea Resend account (the one VedasAI uses). Add
# eject.co as a second verified domain there. Same API key works across all
# domains on the account. Until eject.co is verified, leave RESEND_FROM blank
# and mail sends from onboarding@resend.dev with Reply-To: hi@eject.co.
RESEND_API_KEY=
RESEND_FROM=

# Stripe (billing)
# 1. Create a Stripe account at https://stripe.com → grab keys from /apikeys
# 2. Run `pnpm setup-stripe` (with STRIPE_SECRET_KEY set) — it creates the two
#    products and prints STRIPE_PRICE_* lines to paste below.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EXPRESS=
STRIPE_PRICE_CONCIERGE=

# Lead capture target — pick one
NOTION_DATABASE_ID=
NOTION_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Slack webhook for instant new-lead pings
SLACK_WEBHOOK_URL=

# Lead capture: Google Sheets via Apps Script web app
# Setup walkthrough: docs/setup-leads.md
# (Free, no service account, no GCP project — just a Google Sheet + 30 lines of script)
LEADS_WEBHOOK_URL=

# Public site URL (used in metadata + sitemap)
NEXT_PUBLIC_SITE_URL=https://eject.dev
