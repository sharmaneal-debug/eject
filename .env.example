# Eject — environment variables

# --- Optional LLM rebuild (scripts/rebuild.ts). Static move is the default. ---
# Preferred: OpenAI-compatible open-weights (DeepSeek Flash default).
# LLM_PROVIDER=openai-compat
# LLM_BASE_URL=https://api.deepseek.com
#   Together:  https://api.together.xyz/v1
#   Fireworks: https://api.fireworks.ai/inference/v1
#   OpenRouter:https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-flash
# DeepSeek thinks by default. On *.deepseek.com the client sends
# thinking.type=disabled and omits reasoning_effort (DeepSeek rejects "none").
#   Together Flash slug: deepseek-ai/DeepSeek-V4-Flash-0731
#   Escalation:          qwen/qwen3-coder-480b-a35b (OpenRouter)
# Screenshots: on for Claude and *vision* slugs only. DeepSeek Flash, Together
# Flash, and Qwen3 Coder rebuild from the DOM. LLM_VISION=1 forces images;
# LLM_VISION=0 forces DOM-only.
# LLM_VISION=

# Optional Anthropic path. ANTHROPIC_BASE_URL is not copied from LLM_BASE_URL.
# Unset uses the Anthropic API default. DeepSeek Messages needs its own host:
#   ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
#   ANTHROPIC_API_KEY=<deepseek or anthropic key>
#   ANTHROPIC_MODEL=deepseek-flash
ANTHROPIC_API_KEY=

# Optional: Vercel AI Gateway key (vck_…). If set with the Anthropic path,
# scripts can route Claude calls through Vercel's gateway.
VERCEL_AI_GATEWAY_KEY=

# Soft spend abort for rebuild.ts (USD). Default 5. Harness runs should set 2.
# The autonomous worker skips the model when the estimate is above this.
EJECT_REBUILD_SPEND_CAP_USD=

# Resend (transactional email). Both must be set or the send is skipped.
# There is no onboarding@resend.dev fallback.
RESEND_API_KEY=
RESEND_FROM=
# Internal delivery notice. Unset skips that notice.
LEAD_NOTIFICATION_TO=

# Checkout stays closed unless this is the exact string true.
CHECKOUT_OPEN=
# mock skips Stripe. Unset or stripe_test uses a test secret.
# live accepts a live secret only when CHECKOUT_OPEN is also true.
EJECT_STRIPE_MODE=

# Durable orders on Vercel. Either pair. With neither, /ops warns and
# the file store is /tmp.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer secret for the renewal cron and /api/cron/deliver-orders.
CRON_SECRET=
# Gates /ops (delivery queue and the store warning).
OPS_ACCESS_TOKEN=

# GitHub Actions delivery. On Vercel the function only dispatches
# .github/workflows/deliver-order.yml. Unset leaves paid orders queued.
EJECT_GITHUB_TOKEN=
GITHUB_REPOSITORY=
EJECT_GITHUB_REF=
EJECT_DELIVER_RUNNER=

# Stripe (billing)
# 1. Create a Stripe account at https://stripe.com → grab keys from /apikeys
# 2. Run `pnpm setup-stripe` (with STRIPE_SECRET_KEY set) — it creates the two
#    products and prints STRIPE_PRICE_* lines to paste below.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_EXPRESS=
STRIPE_PRICE_CONCIERGE=

# Lead capture target — pick one
NOTION_DATABASE_ID=
NOTION_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Slack webhook for instant new-lead pings
SLACK_WEBHOOK_URL=

# Lead capture: Google Sheets via Apps Script web app
# Setup walkthrough: docs/setup-leads.md
# (Free, no service account, no GCP project — just a Google Sheet + 30 lines of script)
LEADS_WEBHOOK_URL=

# Public site URL (used in metadata + sitemap)
NEXT_PUBLIC_SITE_URL=https://eject.dev
