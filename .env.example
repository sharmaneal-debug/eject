# Eject — environment variables

# Anthropic Claude API key (required for scripts/rebuild.ts and scripts/editor.ts)
ANTHROPIC_API_KEY=

# Resend (transactional email — intake confirmations, Loom-audit delivery)
RESEND_API_KEY=
RESEND_FROM=hi@eject.dev

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Lead capture target — pick one
NOTION_DATABASE_ID=
NOTION_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Slack webhook for instant new-lead pings
SLACK_WEBHOOK_URL=

# Public site URL (used in metadata + sitemap)
NEXT_PUBLIC_SITE_URL=https://eject.dev
